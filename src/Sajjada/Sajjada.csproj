<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Sajjada</AssemblyName>
    <RootNamespace>Sajjada</RootNamespace>
    <!-- The exe's icon in Explorer; drawn by tools\make_icon.ps1. -->
    <ApplicationIcon>Assets\Sajjada.ico</ApplicationIcon>
    <!-- Per-monitor V2 DPI awareness; see the file. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.1</Version>
    <Product>Sajjada</Product>
    <Description>A decorative Turkish rug for the Windows desktop. Based on Kilim by İbrahim Can Sancar (MIT).</Description>
  </PropertyGroup>

  <!-- One exe that runs without installing .NET. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Compiled ahead of time: the first fold, carry or resize does not pause to compile its code. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Patterns\*.jpg" />
  </ItemGroup>

</Project>
